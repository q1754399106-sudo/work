--- original/core_p1/matlab_src/p1_calibrate_ensemble.m
+++ fixed/core_p1/matlab_src/p1_calibrate_ensemble.m
@@ -1,5 +1,6 @@
 function est=p1_calibrate_ensemble(D,offsets,p)
-% Joint (Q, frequency) calibration with correlated block-bootstrap ensemble.
+% Joint (Q, frequency) point fit and heuristic profile-loss uncertainty.
+% This is not a bootstrap or a calibrated Bayesian posterior.
 % Never reads true Q, true wavelet peak, or reflection coefficients.
 assert(~isfield(p,'Q') && ~isfield(p,'fpeak') && ~isfield(p,'rho'),'Public inputs only');
 est=estimate_q_effective(D,offsets,p);
@@ -14,7 +15,8 @@
 cov_qf=sum(W(:).*(QQ(:)-mq).*(FF(:)-mf));
 est.log_q_std=sqrt(max(vq,0.01));
 est.log_f_std=sqrt(max(vf,0.005));
-est.log_qf_corr=cov_qf/max(sqrt(vq*vf),realmin);
-est.q_perturbation_factors=[0.80,0.90,1.12,1.25];
-est.q_perturbation_weights=[0.20,0.30,0.30,0.20];
+cov_qf=max(-sqrt(vq*vf),min(sqrt(vq*vf),cov_qf));
+est.log_parameter_covariance=[est.log_q_std^2,cov_qf;cov_qf,est.log_f_std^2];
+est.log_qf_corr=cov_qf/(est.log_q_std*est.log_f_std);
+est.uncertainty_interpretation='Heuristic profile-loss covariance with variance floors; not a confidence interval';
 end
--- original/core_p1/matlab_src/p1_modal_penalty.m
+++ fixed/core_p1/matlab_src/p1_modal_penalty.m
@@ -0,0 +1,8 @@
+function r2=p1_modal_penalty(z,f_m,q,fp,p1)
+low_q_weight=exp(-max(0,q-p1.low_q_reference)/p1.low_q_decay_scale);
+u=f_m/max(fp,10); s_prior=u.^2.*exp(1-min(u.^2,20));
+q_sens=(p1.q_sensitivity_scale*low_q_weight*log(1./max(z,1e-4))).^2;
+hf_pen=(2.5*low_q_weight+0.4)*max(0,u-p1.hf_cutoff_factor_q).^2;
+boost=p1.passband_boost_lowq*low_q_weight+p1.passband_boost_base;
+r2=(1+hf_pen+q_sens)./(1+boost*s_prior);
+end
--- original/core_p1/matlab_src/p1_parameter_nodes.m
+++ fixed/core_p1/matlab_src/p1_parameter_nodes.m
@@ -0,0 +1,12 @@
+function [nodes,weights]=p1_parameter_nodes(cm)
+% Positive five-point cubature matching mean/covariance in log(Q,f).
+% Nodes average empirical modal penalties, not a full data-error covariance.
+C=zeros(2); if isfield(cm,'log_parameter_covariance'), C=cm.log_parameter_covariance; end
+assert(isequal(size(C),[2,2]) && all(isfinite(C(:))),'Invalid log parameter covariance');
+C=(C+C')/2; [V,E]=eig(C); ev=diag(E);
+assert(min(ev)>=-1e-12,'Log parameter covariance must be positive semidefinite');
+L=V*diag(sqrt(max(ev,0))); center=log([cm.Q(1);cm.fpeak]);
+delta=sqrt(2.5)*L;
+nodes=exp(center+[zeros(2,1),delta,-delta]);
+weights=ones(1,5)/5;
+end
--- original/core_p1/matlab_src/p1_prepare_calibration.m
+++ fixed/core_p1/matlab_src/p1_prepare_calibration.m
@@ -0,0 +1,7 @@
+function [est,cm,models,R]=p1_prepare_calibration(D,offsets,public)
+% Rebuild calibrated operators and ray projectors together, on every fit.
+est=p1_calibrate_ensemble(D,offsets,public);
+cm=uq_inverse_config(public,est);
+models=prepare_models_v2(public.offset,cm);
+R=avo_projector_v2(models);
+end
